<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Game setup - Albion Reborn" Width="700" Height="480" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#101B22" Foreground="#F2E6CD" FontFamily="Segoe UI">
 <Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="#D4B779"/><Setter Property="Foreground" Value="#152028"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style></Window.Resources>
 <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock x:Name="GameTitle" FontFamily="Georgia" FontSize="30"/><TextBlock x:Name="RuntimeInfo" Foreground="#B7C3C5" Margin="0,8,0,20" TextWrapping="Wrap"/></StackPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal"><Button x:Name="ChooseIso" Content="Choose game ISO"/><Button x:Name="ChooseFolder" Content="Choose extracted files"/></StackPanel>
  <TextBlock Grid.Row="2" x:Name="SourcePath" Text="Choose your ISO or default.xex from an extracted game folder." TextWrapping="Wrap" Foreground="#B6C0C3" Margin="0,14,0,18"/>
  <StackPanel Grid.Row="3"><ProgressBar x:Name="Progress" Height="8" Maximum="100" Foreground="#D4B779"/><TextBlock x:Name="Phase" Text="Your source files stay intact. The runtime installs separately." Margin="0,12,0,5"/><TextBlock x:Name="Detail" Foreground="#9FAFB5" TextWrapping="Wrap" FontSize="11"/></StackPanel>
  <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="UpdateRuntime" Content="Update runtime" IsEnabled="False"/><Button x:Name="Install" Content="Install game" IsEnabled="False"/><Button x:Name="Cancel" Content="Close" Background="#35444B" Foreground="#F2E6CD" Margin="0"/></StackPanel>
 </Grid>
</Window>
