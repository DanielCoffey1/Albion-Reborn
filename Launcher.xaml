<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Albion Reborn" Width="1060" Height="680" MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#101C1B" Foreground="#F1EBDB"
        FontFamily="Segoe UI" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="#D1B57A"/>
      <Setter Property="Foreground" Value="#152321"/>
      <Setter Property="Padding" Value="18,12"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFFFFF"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Locate" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#C3CBBE"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Padding" Value="10,12"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#1B2B28"/>
      <Setter Property="BorderBrush" Value="#374740"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="26"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#B9C5BB"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="21"/>
    </Style>
  </Window.Resources>
  <Grid Margin="38,28,38,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,26">
      <TextBlock Text="THE FABLE COLLECTION" FontSize="11" Foreground="#D1B57A" Margin="1,0,0,10"/>
      <TextBlock Text="Albion Reborn" FontFamily="Georgia" FontSize="44"/>
      <TextBlock Text="Three chapters. A world of choices. Choose your next story." Foreground="#AEBEB3" FontSize="14" Margin="2,12,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Background="#182521">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="I" FontFamily="Georgia" FontSize="68" Foreground="#61715B" Margin="0,0,0,14"/>
            <TextBlock Text="Fable I" FontFamily="Georgia" FontSize="27" Margin="0,0,0,12"/>
            <TextBlock Text="Every hero has a beginning." FontSize="13" Foreground="#D4C59F" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <TextBlock Style="{StaticResource Body}" Text="A place reserved for the first chapter. Add your installation whenever it is ready."/>
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock x:Name="fable1Badge" FontSize="11" Foreground="#9DAE9C" Margin="0,0,0,12"/>
            <Button x:Name="fable1Play" Content="Not installed"/>
            <Button x:Name="fable1Locate" Style="{StaticResource Locate}" Content="Locate game"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="II" FontFamily="Georgia" FontSize="68" Foreground="#8DAA8B" Margin="0,0,0,14"/>
            <TextBlock Text="Fable II" FontFamily="Georgia" FontSize="27" Margin="0,0,0,12"/>
            <TextBlock Text="Your choices shape a kingdom." FontSize="13" Foreground="#D4C59F" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <TextBlock Style="{StaticResource Body}" Text="Return to Albion and continue your story with your existing game settings."/>
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock x:Name="fable2Badge" FontSize="11" Foreground="#A8C6A4" Margin="0,0,0,12"/>
            <Button x:Name="fable2Play" Content="Play"/>
            <Button x:Name="fable2Locate" Style="{StaticResource Locate}" Content="Change location"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="4" Style="{StaticResource Card}" Background="#242B2C">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="III" FontFamily="Georgia" FontSize="68" Foreground="#A2ACBB" Margin="0,0,0,14"/>
            <TextBlock Text="Fable III" FontFamily="Georgia" FontSize="27" Margin="0,0,0,12"/>
            <TextBlock Text="The crown is only the beginning." FontSize="13" Foreground="#D4C59F" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <TextBlock Style="{StaticResource Body}" Text="Lead a revolution with your current lighting and scenery fixes."/>
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock x:Name="fable3Badge" FontSize="11" Foreground="#A8C6A4" Margin="0,0,0,12"/>
            <Button x:Name="fable3Play" Content="Play"/>
            <Button x:Name="fable3Locate" Style="{StaticResource Locate}" Content="Change location"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="2" Margin="0,22,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="Status" Text="Choose your next story." Foreground="#B9C5BB" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/>
      <TextBlock Grid.Column="1" Text="ALBION REBORN  /  0.1" Foreground="#7C9385" FontSize="10" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Window>
